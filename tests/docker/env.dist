# Copied to .env by run.sh on its first run. Edit .env, not this file.

# Names the Docker Compose project, its network and its containers. Change it if it collides with another stack.
E2E_PROJECT_NAME=akeeba-jsonapi-e2e

# The PHP version the *tests* — and therefore the library — run under. This is the one the matrix varies.
E2E_PHP_VERSION=8.5

# The PHP version the fixture server runs under. Only has to be new enough to run the fixture.
E2E_SERVER_PHP_VERSION=8.4

# The full matrix, run by `run.sh --matrix`, lowest to highest. Derived from composer.json's `require.php`.
E2E_PHP_MATRIX="8.2 8.3 8.4 8.5"

# Published on the loopback interface so you can poke at the fixture by hand. The tests do not use these; they reach
# the containers by name over the Compose network. Change them if they collide with another local stack.
E2E_HTTP_PORT=18080
E2E_SINK_HTTP_PORT=18081

# The credentials the fixture accepts. They are not secret and never leave the disposable stack.
E2E_SECRET=TheAkeebaBackupSecretWord
E2E_TOKEN=c2hhMjU2OjcwOjgwMzE3NzRiYWI1YTY0MGY4NWQ2MTI3NjY1YmZiMGY2
E2E_RESTRICTED_TOKEN=c2hhMjU2OjcxOmRlYWRiZWVmZGVhZGJlZWZkZWFkYmVlZmRlYWRiZWVm
