{
	"name": "akeeba/json-backup-api",
	"description": "A PHP client library for talking to the Akeeba Backup and Akeeba Solo JSON API.",
	"minimum-stability": "stable",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Nicholas K. Dionysopoulos",
			"email": "nicholas_NOSPAM@akeeba.com",
			"homepage": "https://www.dionysopoulos.me",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">= 8.2.0 < 8.7",
		"ext-json": "*",
		"composer/ca-bundle": "^1.3.0",
		"psr/log": "^2.0.0|^3.0.0",
		"psr/http-client": "^1.0.0",
		"psr/http-factory": "^1.0.0",
		"psr/http-message": ">=1.0",
		"composer-runtime-api": "^2.0.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"guzzlehttp/guzzle": "^7.8",
		"joomla/http": "^3.0"
	},
	"suggest": {
		"ext-curl": "Allows the cURL method for archive downloads",
		"guzzlehttp/guzzle": "The standard PHP HTTP client (see HttpClientGuzzle)",
		"joomla/http": "A less capable, but lightning fast, PHP HTTP client (see HttpClientJoomla)"
	},
	"autoload": {
		"psr-4": {
			"Akeeba\\BackupJsonApi\\": [
				"src"
			]
		},
		"files": [
			"src/constants.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Akeeba\\BackupJsonApi\\Tests\\": [
				"tests"
			]
		}
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.999"
		}
	},
	"archive": {
		"exclude": [
			"/.claude",
			"/.idea",
			"/vendor",
			"/tests",
			"/phpunit.xml",
			"/phpunit-integration.xml",
			"/mempalace.yaml",
			"/rector.php",
			"/.phpunit.cache",
			".phpunit.result.cache",
			".gitignore"
		]
	}
}